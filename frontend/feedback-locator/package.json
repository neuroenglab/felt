{
  "name": "@neuroenglab/nel-feedback-ui",
  "version": "0.0.4",
  "type": "module",
  "description": "Neuroengineering feedback UI: body part selector and sensation locator components",
  "main": "./dist/nel-feedback-ui.umd.js",
  "module": "./dist/nel-feedback-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nel-feedback-ui.es.js",
      "require": "./dist/nel-feedback-ui.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuroenglab/feedback-locator.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "preview": "vite build && vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  }
}
